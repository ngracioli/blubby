{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "reactNative": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      },
      "correctness": {
        "noReactNativeRawText": "off"
      },
      "style": {
        "useImportType": "off"
      }
    }
  }
}
